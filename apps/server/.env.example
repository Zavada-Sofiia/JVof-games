# База (docker compose з infra/ піднімає її на 5433)
DATABASE_URL=postgresql://jvof:jvof@localhost:5433/jvof

PORT=3001
# Адреса фронтенду: для CORS і посилань у листах
WEB_ORIGIN=http://localhost:5173

# Секрет для access-JWT. Згенерувати: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Пошта (необов'язково). Без ключа листи друкуються в консоль сервера.
RESEND_API_KEY=
MAIL_FROM=JVof games <noreply@example.com>

# Cloudflare TURN (рекомендовано, безкоштовно 1000 ГБ/міс): Realtime → TURN Server → Create
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Або будь-який інший TURN, якщо двоє не можуть з'єднатися напряму
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
